# ==============================================================================
# SilvaTwin Project - Root .gitignore
# ==============================================================================

# --- Entornos Virtuales de Python ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Dependencias de Node & Frontend ---
node_modules/
dist/
build/
coverage/
.vite/
.bun/
bun.lockb

# --- Archivos de Datos Satelitales y Científicos Pesados (>50MB / 1.35GB) ---
# GitHub rechaza archivos mayores a 100MB; GEDI (.h5) y GeoTIFF (.tif) no deben subirse
*.h5
*.hdf5
*.tif
*.tiff
*.nc
*.grib
*.grib2
*.geotiff

# Permitir archivos de documentación README dentro de las carpetas de datos
!**/data/**/README.md
!**/data/**/.gitkeep

# --- Bases de Datos Locales ---
*.db
*.sqlite
*.sqlite3
silvatwin.db
silvatwin.db-journal

# --- Variables de Entorno y Secretos ---
.env
.env.local
.env.*.local
!.env.example

# --- Python Cache y Compilación ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Logs y Archivos Temporales ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Archivos de Sistema Operativo e IDEs ---
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
